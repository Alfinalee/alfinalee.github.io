---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SystemMap from '../components/SystemMap.astro';
import ArticleItem from '../components/ArticleItem.astro';
import { getArticles } from '../lib/writing';
import { SITE_TAGLINE } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = (await getArticles()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TAGLINE}</h1>
    <p class="lead">Placeholder: one line on what I do and for whom.</p>
  </section>

  <section>
    <h2>About</h2>
    <p>
      Placeholder: two or three sentences on who I am, what I've worked on, and what kind of
      work I'm looking for.
    </p>
  </section>

  <section>
    <h2>How it fits together</h2>
    <SystemMap />
  </section>

  <section>
    <h2>Projects</h2>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {articles.length > 0 && (
    <section>
      <h2>Writing</h2>
      <ul class="article-list">
        {articles.map((article) => <ArticleItem article={article} showTopic />)}
      </ul>
      <p><a href="/writing/">All writing, by topic →</a></p>
    </section>
  )}
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleItem from '../../components/ArticleItem.astro';
import { getArticles } from '../../lib/writing';

export async function getStaticPaths() {
  // Projects with externalUrl live elsewhere; only build pages for the rest.
  const projects = await getCollection('projects', ({ data }) => !data.externalUrl);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, tags, image } = project.data;
const { Content } = await render(project);
const related = (await getArticles()).filter((article) =>
  article.data.projects.some((ref) => ref.id === project.id),
);
const shareImage = image ? (await getImage({ src: image, format: 'png', width: 1200 })).src : undefined;
---

<BaseLayout title={title} description={summary} image={shareImage} type="article">
  <article class="prose">
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    <Content />
  </article>

  {related.length > 0 && (
    <section>
      <h2>Related writing</h2>
      <ul class="article-list">
        {related.map((article) => (
          <ArticleItem article={article} />
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

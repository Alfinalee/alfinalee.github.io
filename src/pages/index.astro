---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SystemMap from '../components/SystemMap.astro';
import ArticleItem from '../components/ArticleItem.astro';
import { getArticles } from '../lib/writing';
import { SITE_TAGLINE } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = (await getArticles()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TAGLINE}</h1>
    <p class="lead">
      I turn messy business problems into working AI systems, with humans kept in charge of the
      decisions that matter.
    </p>
  </section>

  <section>
    <h2>About</h2>
    <p>
      I'm an IT consultant who builds the systems I advise on. Over the past year I've built an AI
      agent that runs my one-person coaching business, a personal companion agent, and a second
      brain that keeps my context portable across AI vendors. Lately I'm most interested in the
      bridge between business and systems, and in how neural networks and AI agents work under the
      hood.
    </p>
  </section>

  <section>
    <h2>How it fits together</h2>
    <SystemMap />
  </section>

  <section>
    <h2>Projects</h2>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {articles.length > 0 && (
    <section>
      <h2>Writing</h2>
      <ul class="article-list">
        {articles.map((article) => <ArticleItem article={article} showTopic />)}
      </ul>
      <p><a href="/writing/">All writing, by topic →</a></p>
    </section>
  )}
</BaseLayout>
